<Window x:Class="OnRecord.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OnRecord"
        Width="508" Height="688" MinWidth="360" MinHeight="380"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="False"
        Background="Transparent" ShowInTaskbar="False">
    <!-- Top-level window: transparent, holds the acrylic glass + shadow (composition) behind.
         Margin = shadow space around the glass; must match MainWindow.ShadowMargin. -->
    <Grid x:Name="HostSlot" Margin="24"/>
</Window>
