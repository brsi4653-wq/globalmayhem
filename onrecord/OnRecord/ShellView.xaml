<UserControl x:Class="OnRecord.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:chat="clr-namespace:OnRecord.Chat"
             FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="#F2FFFFFF"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <!-- Round translucent icon button used in the top bar -->
        <Style x:Key="RoundButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="#E6FFFFFF"/>
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="16" Background="{TemplateBinding Background}"
                                BorderBrush="#14FFFFFF" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#4DFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Buttons on the light preview panel -->
        <Style x:Key="LightTextButton" TargetType="Button">
            <Setter Property="Foreground" Value="#222"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="15" Background="#14000000" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#26000000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#38000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LightIconButton" TargetType="Button" BasedOn="{StaticResource LightTextButton}">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="15" Background="#14000000">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#26000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Dark base over the acrylic -->
        <Border CornerRadius="30" Background="#9E121216"/>
        <!-- Mode tint gradient: ~32% at the top fading to ~8% at the bottom -->
        <Border CornerRadius="30">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop x:Name="TintTop" Offset="0"/>
                    <GradientStop x:Name="TintBottom" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <!-- Subtle 1px light border -->
        <Border CornerRadius="30" BorderThickness="1">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#40FFFFFF" Offset="0"/>
                    <GradientStop Color="#14FFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top bar: drag area -->
            <Grid x:Name="TopBar" Grid.Row="0" Height="60" Background="Transparent"
                  MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="16,0,0,0">
                    <Button x:Name="CloseButton" Style="{StaticResource RoundButton}" Content="&#xE8BB;"
                            ToolTip="Close" Click="CloseButton_Click"/>
                    <Button x:Name="NewChatButton" Style="{StaticResource RoundButton}" Content="&#xE70F;"
                            Margin="8,0,0,0" FontSize="12" ToolTip="New chat" Click="NewChatButton_Click"/>
                </StackPanel>

                <Border x:Name="ModePill" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Height="28" Padding="12,0,14,0" CornerRadius="14" IsHitTestVisible="False"
                        Background="#1FFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="ModeDot" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ModeName" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Foreground="#F2FFFFFF"/>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,16,0">
                    <Button x:Name="SettingsButton" Style="{StaticResource RoundButton}" Content="&#xE713;"
                            Margin="0,0,8,0" FontSize="12" ToolTip="Settings" Click="SettingsButton_Click"/>
                    <Button x:Name="PinButton" Style="{StaticResource RoundButton}" Content="&#xE718;"
                            Margin="0,0,8,0" ToolTip="Pin on top" Click="PinButton_Click"/>
                    <Button x:Name="ExpandButton" Style="{StaticResource RoundButton}" Content="&#xE740;"
                            ToolTip="Expand" Click="ExpandButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- Body: chat, plus the artifact preview beside it when one is open and the window is wide -->
            <Grid x:Name="Body" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ChatColumn" Width="*"/>
                    <ColumnDefinition x:Name="PreviewColumn" Width="0"/>
                </Grid.ColumnDefinitions>

                <chat:ChatPanel x:Name="Chat" Grid.Column="0"/>

                <!-- Rounded light preview panel. The web page itself is a separate WebView2 window kept
                     over WebSlot (see ArtifactWebView). -->
                <Border x:Name="PreviewPanel" Grid.Column="1" Visibility="Collapsed"
                        Margin="2,0,14,14" CornerRadius="22" Background="#F7F7F8"
                        BorderBrush="#33FFFFFF" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="16,10,10,6" LastChildFill="True">
                            <Button x:Name="PreviewCloseButton" DockPanel.Dock="Right" Style="{StaticResource LightIconButton}"
                                    Content="&#xE8BB;" ToolTip="Close preview" Click="PreviewClose_Click"/>
                            <Button x:Name="PreviewShowFileButton" DockPanel.Dock="Right" Style="{StaticResource LightTextButton}" Content="Show file"
                                    Margin="0,0,6,0" Click="PreviewShowFile_Click"/>
                            <Button x:Name="PreviewOpenButton" DockPanel.Dock="Right" Style="{StaticResource LightTextButton}" Content="Open in browser"
                                    Margin="0,0,6,0" Click="PreviewOpenBrowser_Click"/>
                            <!-- Web pages only: Back and Reload (no tabs, no address bar) -->
                            <Button x:Name="PreviewBackButton" DockPanel.Dock="Left" Style="{StaticResource LightIconButton}"
                                    Content="&#xE72B;" ToolTip="Back" Margin="-6,0,6,0" Visibility="Collapsed" Click="PreviewBack_Click"/>
                            <Button x:Name="PreviewReloadButton" DockPanel.Dock="Left" Style="{StaticResource LightIconButton}"
                                    Content="&#xE72C;" ToolTip="Reload" Margin="0,0,10,0" Visibility="Collapsed" Click="PreviewReload_Click"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="PreviewIcon" Text="&#xE8A5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                           Foreground="#666" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock x:Name="PreviewFileName" FontSize="13.5" FontWeight="SemiBold" Foreground="#222"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DockPanel>
                        <!-- Placeholder the web view is positioned over (inset so its square corners stay
                             inside the panel's rounded ones). -->
                        <Border x:Name="WebSlot" Grid.Row="1" Margin="8,0,8,8" Background="White" CornerRadius="10">
                            <TextBlock x:Name="WebSlotHint" Text="Loading…" Foreground="#999" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <!-- Native previews of the user's own files (images, text): no web view needed. -->
                        <Border x:Name="NativePreview" Grid.Row="1" Margin="8,0,8,8" Background="White" CornerRadius="10"
                                Visibility="Collapsed" ClipToBounds="True">
                            <Grid>
                                <Image x:Name="PreviewImage" Stretch="Uniform" StretchDirection="DownOnly" Margin="10"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBox x:Name="PreviewText" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                         Foreground="#1E1E1E" FontFamily="Cascadia Mono, Consolas" FontSize="12.5"
                                         Padding="12,10" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Resize grip, bottom-right -->
        <Canvas Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,14,14" IsHitTestVisible="False" Opacity="0.45">
            <Ellipse Canvas.Left="9" Canvas.Top="1" Width="2.5" Height="2.5" Fill="White"/>
            <Ellipse Canvas.Left="5" Canvas.Top="5" Width="2.5" Height="2.5" Fill="White"/>
            <Ellipse Canvas.Left="9" Canvas.Top="5" Width="2.5" Height="2.5" Fill="White"/>
            <Ellipse Canvas.Left="1" Canvas.Top="9" Width="2.5" Height="2.5" Fill="White"/>
            <Ellipse Canvas.Left="5" Canvas.Top="9" Width="2.5" Height="2.5" Fill="White"/>
            <Ellipse Canvas.Left="9" Canvas.Top="9" Width="2.5" Height="2.5" Fill="White"/>
        </Canvas>
    </Grid>
</UserControl>
