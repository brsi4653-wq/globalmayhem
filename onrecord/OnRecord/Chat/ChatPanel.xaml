<UserControl x:Class="OnRecord.Chat.ChatPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" PreviewDragOver="Panel_DragOver" PreviewDragEnter="Panel_DragOver"
             PreviewDragLeave="Panel_DragLeave" PreviewDrop="Panel_Drop">
    <UserControl.Resources>
        <!-- Thin, quiet scrollbar for the glass -->
        <Style x:Key="ThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border CornerRadius="3" Background="#40FFFFFF" Margin="1,0"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ThumbStyle}"/>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillIconButton" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Foreground" Value="#E6FFFFFF"/>
            <Setter Property="Background" Value="#1FFFFFFF"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Bg" Fill="{TemplateBinding Background}"/>
                            <Ellipse x:Name="Hover" Fill="White" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="0.12"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="0.22"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="EmptyHint" Text="Ask Claude anything" FontSize="15" Foreground="#66FFFFFF"
                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>

        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Focusable="False" Margin="0,0,6,0" ScrollChanged="Scroller_ScrollChanged">
            <StackPanel x:Name="Messages" Margin="22,4,16,12"/>
        </ScrollViewer>

        <!-- Drop hint shown while files are dragged over the popup -->
        <Border x:Name="DropHint" Grid.RowSpan="2" Margin="12" CornerRadius="22" Visibility="Collapsed"
                BorderBrush="#99FFFFFF" BorderThickness="2" Background="#33000000" IsHitTestVisible="False">
            <TextBlock Text="Drop files to attach" Foreground="White" FontSize="16" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <StackPanel Grid.Row="1">
        <!-- Attachments waiting to be sent -->
        <TextBlock x:Name="AttachError" Foreground="#FFB4B4" FontSize="12.5" TextWrapping="Wrap"
                   Margin="22,0,22,4" Visibility="Collapsed"/>
        <WrapPanel x:Name="AttachmentChips" Margin="16,2,16,0"/>

        <!-- Input bar -->
        <Border Margin="14,4,14,14" CornerRadius="25" MinHeight="50"
                Background="#24FFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1" Padding="7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="AttachButton" Style="{StaticResource PillIconButton}" Content="&#xE710;"
                        ToolTip="Attach files (or drag them here, or paste with Ctrl+V)" Click="AttachButton_Click"/>

                <Grid Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                    <TextBlock x:Name="Placeholder" Text="Ask Claude…" Foreground="#73FFFFFF" FontSize="14.5"
                               VerticalAlignment="Center" Margin="2,0,0,0" IsHitTestVisible="False"/>
                    <TextBox x:Name="InputBox" Background="Transparent" BorderThickness="0" Foreground="#F2FFFFFF"
                             CaretBrush="White" SelectionBrush="#80FFFFFF" FontSize="14.5" Padding="0,6"
                             TextWrapping="Wrap" AcceptsReturn="False" MaxHeight="140"
                             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Center"
                             PreviewKeyDown="InputBox_PreviewKeyDown" TextChanged="InputBox_TextChanged">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                              VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"/>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>
                </Grid>

                <!-- Reserved for the microphone button later -->
                <ContentControl x:Name="MicSlot" Grid.Column="2" Visibility="Collapsed" Margin="0,0,6,0"/>

                <Button x:Name="SendButton" Grid.Column="3" Style="{StaticResource PillIconButton}"
                        Content="&#xE74A;" FontWeight="Bold" Foreground="White" ToolTip="Send (Enter)"
                        Click="SendButton_Click"/>
            </Grid>
        </Border>
        </StackPanel>
    </Grid>
</UserControl>
