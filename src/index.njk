---
layout: layouts/base.njk
---
{%- set app = site.onrecord %}
<section class="stage stage--home stage--short">
  <div class="stage__mark" aria-hidden="true">{% set markClass = "" %}{% include "mark.njk" %}</div>
  <div class="wrap stage__inner">
    <h1 class="stage__title" data-rise>{{ site.name }}</h1>
  </div>
</section>

<div class="marquee" aria-hidden="true">
  <div class="marquee__track">
    {%- for half in range(0, 2) %}
    <div class="marquee__half">
      {%- for rep in range(0, 4) %}
      <span>{{ app.name }}</span>{% set markClass = "mark--black" %}{% include "mark.njk" %}<span>{{ site.name }}</span>{% include "mark.njk" %}
      {%- endfor %}
    </div>
    {%- endfor %}
  </div>
</div>

<section class="product">
  <div class="wrap product__inner">
    <div class="product__head">
      <p class="label">Our product</p>
      <img class="product__logo" src="{{ app.logo }}" width="160" height="160" alt="{{ app.name }} logo">
      <h2 class="product__name">{{ app.name }}</h2>
      <p class="product__line">{{ app.line }}</p>
      <a class="download" href="{{ app.download }}">Download {{ app.name }} for Windows</a>
      <p class="product__version" data-version hidden></p>
    </div>

    <ol class="steps">
      <li><span class="steps__num">1</span><div><h3>Download</h3><p>Use the button above.</p></div></li>
      <li><span class="steps__num">2</span><div><h3>Open OnRecord-Setup.exe</h3><p>If Windows says "Windows protected your PC", click <strong>More info</strong>, then <strong>Run anyway</strong>. This shows because the installer is not code-signed yet.</p></div></li>
      <li><span class="steps__num">3</span><div><h3>Follow the installer</h3><p>It checks your Claude Code setup. Then press <strong>Alt+Space</strong>.</p></div></li>
    </ol>

    <p class="product__req"><strong>Requirements:</strong> Windows 11 with transparency effects on, and Claude Code installed and signed in with a paid Claude plan.</p>

    <div class="product__note">
      <h3 class="label">What you're downloading</h3>
      <ul>
        <li>The OnRecord installer for Windows.</li>
        <li>It installs for your user only. No admin rights needed.</li>
        <li>Open source. <a href="{{ app.code }}">Read the code</a>.</li>
        <li><span class="aitag">AI was used in the making</span> OnRecord was built with the help of AI.</li>
        <li>SHA-256 checksum: <span data-sha><a href="{{ app.releases }}">see the release notes</a></span></li>
      </ul>
    </div>

    <div class="product__note relnotes" data-notes hidden>
      <h3 class="label">Latest release notes</h3>
      <div data-notes-body></div>
    </div>
  </div>
</section>
<script>
// Shows the version and checksum of the newest release. If GitHub cannot
// be reached, the version line stays hidden and the page still works.
fetch("{{ app.latestApi }}", { headers: { Accept: "application/vnd.github+json" } })
  .then(function (r) { if (!r.ok) throw 0; return r.json(); })
  .then(function (rel) {
    var m = /^onrecord-v(\d[\w.]*)$/.exec(rel.tag_name || "");
    if (!m) return;
    var v = document.querySelector("[data-version]");
    v.textContent = "Version " + m[1];
    v.hidden = false;
    // The release notes, shown as plain paragraphs and bullet lists.
    var esc = function (t) { return t.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;"); };
    var inline = function (t) { return esc(t).replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>").replace(/`([^`]+)`/g, "<code>$1</code>"); };
    var html = "", list = false;
    String(rel.body || "").split(/\r?\n/).forEach(function (line) {
      line = line.trim();
      var item = /^[-*]\s+(.*)$/.exec(line);
      if (item) { if (!list) { html += "<ul>"; list = true; } html += "<li>" + inline(item[1]) + "</li>"; return; }
      if (list) { html += "</ul>"; list = false; }
      if (line) html += "<p>" + inline(line) + "</p>";
    });
    if (list) html += "</ul>";
    if (html) {
      document.querySelector("[data-notes-body]").innerHTML = html;
      document.querySelector("[data-notes] .label").textContent = "Latest release notes: " + (rel.name || m[1]);
      document.querySelector("[data-notes]").hidden = false;
    }
    var file = (rel.assets || []).filter(function (a) { return a.name === "OnRecord-Setup.exe"; })[0];
    var sha = file && /^sha256:([0-9a-f]{64})$/.exec(file.digest || "");
    if (sha) {
      var code = document.createElement("code");
      code.textContent = sha[1];
      document.querySelector("[data-sha]").replaceChildren(code);
    }
  })
  .catch(function () {});
</script>
